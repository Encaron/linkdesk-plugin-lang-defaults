{
  "$schema": "./node_modules/@linkdesk/plugin-sdk/schemas/plugin.schema.json",
  "pluginId": "lang-defaults",
  "name": "官方语言",
  "version": "1.0.72",
  "category": "development",
  "categories": [
    "i18n"
  ],
  "icon": "resources/icon.svg",
  "description": "出厂中文/English 语言包——可卸载，卸载后 t(key) 返回 key 原文",
  "author": "Encaron",
  "contributes": {
    "languages": [
      {
        "id": "zh",
        "label": "中文",
        "path": "zh.json"
      },
      {
        "id": "en",
        "label": "English",
        "path": "en.json"
      }
    ]
  },
  "readme": {
    "default": "README.md",
    "locales": {
      "zh": "README.md",
      "en": "docs/readme/en.md"
    }
  }
}
